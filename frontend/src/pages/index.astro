    </section>

    <!-- Tech Stack -->
    <section class="site-section px-4 sm:px-6 py-16 sm:py-24">
      <div class="mx-auto max-w-5xl flex flex-wrap gap-3 text-sm sm:text-base">
        <span class="card-bulge rounded-full px-5 py-2.5 text-white/95">Python</span>
        <span class="card-bulge rounded-full px-5 py-2.5 text-white/95">HMM</span>

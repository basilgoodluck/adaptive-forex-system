                  <td class="px-5 py-3 whitespace-nowrap">1.27310</td>
                  <td class="px-5 py-3 whitespace-nowrap">DOWN</td>
                  <td class="px-5 py-3 whitespace-nowrap">0.0033</td>
                  <td class="px-5 py-3 whitespace-nowrap">reversal</td>
                </tr>
                <tr class="border-b border-white/10">

            <text x="420" y="94" text-anchor="middle" fill="white" fill-opacity="0.5" font-size="13">3</text>
          </g>
          <g>
            <rect x="625" y="25" width="170" height="80" rx="14" fill="#1f6b3f" stroke="rgba(255,255,255,0.15)" />
            <text x="710" y="60" text-anchor="middle" fill="white" font-size="19" font-family="Fraunces, serif" font-style="italic">Execution</text>
            <text x="710" y="82" text-anchor="middle" fill="white" fill-opacity="0.5" font-size="13">5</text>
          </g>

          <g>
            <rect x="185" y="235" width="170" height="80" rx="14" fill="#061a0e" stroke="rgba(255,255,255,0.1)" />
            <text x="270" y="265" text-anchor="middle" fill="white" fill-opacity="0.85" font-size="18" font-family="Fraunces, serif" font-style="italic">Regime</text>
            <text x="270" y="286" text-anchor="middle" fill="white" fill-opacity="0.85" font-size="18" font-family="Fraunces, serif" font-style="italic">Detector</text>
            <text x="270" y="304" text-anchor="middle" fill="white" fill-opacity="0.4" font-size="13">2</text>
          </g>
          <g>
            <rect x="475" y="235" width="170" height="80" rx="14" fill="#061a0e" stroke="rgba(255,255,255,0.1)" />
            <text x="560" y="265" text-anchor="middle" fill="white" fill-opacity="0.85" font-size="18" font-family="Fraunces, serif" font-style="italic">Risk</text>
            <text x="560" y="286" text-anchor="middle" fill="white" fill-opacity="0.85" font-size="18" font-family="Fraunces, serif" font-style="italic">Manager</text>
            <text x="560" y="304" text-anchor="middle" fill="white" fill-opacity="0.4" font-size="13">4</text>
          </g>
          <g>
            <rect x="765" y="235" width="170" height="80" rx="14" fill="#061a0e" stroke="rgba(255,255,255,0.1)" />
            <text x="850" y="270" text-anchor="middle" fill="white" fill-opacity="0.85" font-size="19" font-family="Fraunces, serif" font-style="italic">Logger</text>
            <text x="850" y="294" text-anchor="middle" fill="white" fill-opacity="0.4" font-size="13">6</text>
          </g>
        </svg>
      </div>
    </section>

    <!-- Training Data -->
    <section class="site-section px-4 sm:px-6 py-16 sm:py-24">
      <div class="mx-auto max-w-5xl">
        <h2 class="font-display italic text-3xl sm:text-4xl mb-8 sm:mb-10">Training Data</h2>
        <div class="card-deep rounded-3xl overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse font-mono text-xs sm:text-sm">
              <thead>
                <tr class="border-b border-white/10">
                  <th class="px-5 py-3 text-white/50 font-normal whitespace-nowrap">timestamp</th>
                  <th class="px-5 py-3 text-white/50 font-normal whitespace-nowrap">symbol</th>
                  <th class="px-5 py-3 text-white/50 font-normal whitespace-nowrap">price</th>
                  <th class="px-5 py-3 text-white/50 font-normal whitespace-nowrap">dc_event</th>
                  <th class="px-5 py-3 text-white/50 font-normal whitespace-nowrap">magnitude</th>
                  <th class="px-5 py-3 text-white/50 font-normal whitespace-nowrap">regime</th>
                </tr>
              </thead>
              <tbody class="text-white/80">
                <tr class="border-b border-white/10">
                  <td class="px-5 py-3 whitespace-nowrap">2024-03-11T09:15:00Z</td>
                  <td class="px-5 py-3 whitespace-nowrap">EURUSD</td>
                  <td class="px-5 py-3 whitespace-nowrap">1.08421</td>
                  <td class="px-5 py-3 whitespace-nowrap">UP</td>
                  <td class="px-5 py-3 whitespace-nowrap">0.0021</td>
                  <td class="px-5 py-3 whitespace-nowrap">trend</td>
                </tr>
                <tr class="border-b border-white/10">
                  <td class="px-5 py-3 whitespace-nowrap">2024-03-11T09:30:00Z</td>
                  <td class="px-5 py-3 whitespace-nowrap">EURUSD</td>
                  <td class="px-5 py-3 whitespace-nowrap">1.08497</td>
                  <td class="px-5 py-3 whitespace-nowrap">UP</td>
                  <td class="px-5 py-3 whitespace-nowrap">0.0018</td>
                  <td class="px-5 py-3 whitespace-nowrap">trend</td>
